<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>

      <!-- Remove WebDAV which blocks PUT, DELETE, PATCH on Azure App Service -->
      <modules>
        <remove name="WebDAVModule" />
      </modules>

      <handlers>
        <remove name="WebDAV" />
        <!-- Catch-all handler — verb="*" ensures POST/PUT/PATCH/DELETE all reach the app -->
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>

      <!-- IsTransformWebConfigDisabled=true in csproj — this element is NOT modified by SDK -->
      <aspNetCore processPath="dotnet"
                  arguments=".\SalesforceConnectOData.dll"
                  stdoutLogEnabled="false"
                  stdoutLogFile=".\logs\stdout"
                  hostingModel="inprocess" />

      <!-- Allow all HTTP verbs used by OData CRUD -->
      <security>
        <requestFiltering>
          <verbs allowUnlisted="true">
            <add verb="GET"     allowed="true" />
            <add verb="POST"    allowed="true" />
            <add verb="PUT"     allowed="true" />
            <add verb="PATCH"   allowed="true" />
            <add verb="DELETE"  allowed="true" />
            <add verb="OPTIONS" allowed="true" />
          </verbs>
        </requestFiltering>
      </security>

    </system.webServer>
  </location>
</configuration>
